---
import { siteConfig } from "@/config";
import { collectPageConfig } from "@/config/collectPageConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCollectApiStats } from "@/utils/collect-catalog";

if (!siteConfig.pages.collect) {
	return Astro.redirect("/404/");
}

const {
	title,
	description,
	eyebrow,
	issue,
	updatedAt,
	updateNote,
	githubUrl,
	deskUrl,
	fastestLabel,
	panels,
} = collectPageConfig;

const apiStats = getCollectApiStats();
const panelCount = panels.length;
const dateText = updatedAt || apiStats.updated || new Date().toISOString().slice(0, 10);
const fastestText =
	apiStats.fastestName
		? apiStats.fastestMs
			? `${apiStats.fastestName} · ${apiStats.fastestMs}ms`
			: apiStats.fastestName
		: fastestLabel || "—";

const publishedPanels = panels.map((panel) => {
	const sources = panel.sources.filter((source) => !source.pending);
	if (panel.id !== "movie" || panel.comingSoon) {
		return { ...panel, sources };
	}
	return {
		...panel,
		sources: sources.map((source) => {
			if (source.title === "接口总数") {
				return {
					...source,
					desc: `现有 ${apiStats.total} 个影视采集接口`,
					badge: String(apiStats.total),
				};
			}
			if (source.title === "当前在线") {
				return {
					...source,
					desc: `在线 ${apiStats.online} · 离线 ${apiStats.offline}`,
					badge: String(apiStats.online),
				};
			}
			if (source.title.startsWith("高可用")) {
				return {
					...source,
					desc: `${apiStats.highAvail} 个可进一键配置`,
					badge: String(apiStats.highAvail),
				};
			}
			return source;
		}),
	};
});
---
<MainGridLayout title={title} description={description}>
	<div class="signal-desk" id="signal-desk">
		<header class="signal-header">
			<div class="signal-meta">
				<p class="signal-live">
					<span class="signal-dot" aria-hidden="true" />
					{eyebrow}
				</p>
				<p class="signal-meta-right">
					<span>第 {issue} 期</span>
					<span class="signal-sep">·</span>
					<span>{dateText}</span>
					<span class="signal-sep">·</span>
					<span>{updateNote}</span>
				</p>
			</div>

			<div class="signal-title-row">
				<div class="signal-title-block">
					<h1 class="signal-title">{title}</h1>
					<p class="signal-subtitle">{description}</p>
				</div>
				<div class="signal-actions">
					{
						deskUrl && (
							<a class="signal-desk-link" href={deskUrl} data-no-swup>
								接口监控台
								<span aria-hidden="true">↗</span>
							</a>
						)
					}
					{
						githubUrl && (
							<a
								class="signal-github"
								href={githubUrl}
								target="_blank"
								rel="noopener noreferrer"
							>
								GITHUB
								<span aria-hidden="true">↗</span>
							</a>
						)
					}
				</div>
			</div>
		</header>

		<div class="signal-grid" role="list">
			{
				publishedPanels.map((panel) => {
					const canEnter = !panel.comingSoon && (panel.href || deskUrl);
					const enterHref = panel.href || deskUrl;
					return (
						<article
							class:list={[
								"signal-card",
								{ "is-dark-text": panel.darkText, "is-soon": panel.comingSoon },
							]}
							style={`--signal-bg: ${panel.color}`}
							id={panel.id}
							role="listitem"
						>
							{
								canEnter && enterHref && (
									<a
										class="signal-card-hit"
										href={enterHref}
										data-no-swup
										aria-label={`打开 · ${panel.name}`}
									>
										<span class="sr-only">打开 {panel.name}</span>
									</a>
								)
							}
							<span class="signal-numeral" aria-hidden="true">{panel.numeral}</span>
							<div class="signal-card-inner">
								<p class="signal-kicker">
									{panel.name}
									{panel.comingSoon && <em class="signal-soon-tag">筹备中</em>}
								</p>
								<h2 class="signal-headline">{panel.headline}</h2>
								<ul class="signal-sources">
									{panel.sources.slice(0, 4).map((source) => (
										<li>
											{source.endpoint && !panel.comingSoon ? (
												<button
													type="button"
													class="signal-source-btn"
													data-copy={source.endpoint === "desk" ? enterHref : source.endpoint}
													title={source.desc || source.title}
												>
													<span class="signal-source-title">
														{source.title}
														{source.badge && (
															<em class="signal-badge">{source.badge}</em>
														)}
													</span>
													{source.desc && (
														<span class="signal-source-desc">{source.desc}</span>
													)}
												</button>
											) : (
												<div class="signal-source-btn is-static">
													<span class="signal-source-title">
														{source.title}
														{source.badge && (
															<em class="signal-badge">{source.badge}</em>
														)}
													</span>
													{source.desc && (
														<span class="signal-source-desc">{source.desc}</span>
													)}
												</div>
											)}
										</li>
									))}
								</ul>
								<div class="signal-card-foot">
									<span>{panel.dateLabel || dateText.slice(5).replace("-", " / ")}</span>
									<span class="signal-copy-hint">
										{panel.comingSoon
											? "暂未开放"
											: canEnter
												? "点击卡片进入 →"
												: "点选复制"}
									</span>
								</div>
							</div>
						</article>
					);
				})
			}
		</div>

		<footer class="signal-footer">
			<div class="signal-stat">
				<span class="signal-stat-label">分类</span>
				<span class="signal-stat-value">{panelCount}</span>
			</div>
			<div class="signal-stat">
				<span class="signal-stat-label">接口总数</span>
				<span class="signal-stat-value">{apiStats.total}</span>
			</div>
			<div class="signal-stat">
				<span class="signal-stat-label">当前在线</span>
				<span class="signal-stat-value">{apiStats.online}</span>
			</div>
			<div class="signal-stat signal-stat-fast">
				<span class="signal-stat-label">本期最快</span>
				<span class="signal-stat-value">{fastestText}</span>
			</div>
		</footer>
	</div>
</MainGridLayout>

<style>
	.signal-desk {
		color: #1c1917;
	}

	:global(.dark) .signal-desk {
		color: #f5f5f4;
	}

	.signal-header {
		margin-bottom: 1.25rem;
		padding: 0.25rem 0.15rem 0.15rem;
	}

	.signal-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.6rem 1.25rem;
		margin-bottom: 1rem;
		font-size: 0.72rem;
		letter-spacing: 0.06em;
	}

	.signal-live {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0.35rem 0.75rem;
		border-radius: 9999px;
		font-weight: 700;
		color: #dc2626;
		background: color-mix(in srgb, #dc2626 10%, transparent);
	}

	.signal-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 9999px;
		background: #dc2626;
		box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.45);
		animation: signal-pulse 1.8s ease-out infinite;
	}

	@keyframes signal-pulse {
		70% { box-shadow: 0 0 0 0.5rem rgba(220, 38, 38, 0); }
		100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0); }
	}

	.signal-meta-right {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		opacity: 0.55;
	}

	.signal-sep {
		opacity: 0.4;
	}

	.signal-title-row {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem 1.5rem;
	}

	.signal-title {
		margin: 0;
		font-size: clamp(1.85rem, 4vw, 2.4rem);
		font-weight: 800;
		letter-spacing: 0.02em;
		line-height: 1.15;
	}

	.signal-subtitle {
		margin: 0.45rem 0 0;
		max-width: 36rem;
		font-size: 0.9rem;
		line-height: 1.5;
		opacity: 0.55;
	}

	.signal-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
	}

	.signal-desk-link,
	.signal-github {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.55rem 1.1rem;
		border-radius: 9999px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		transition: background-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
	}

	.signal-desk-link {
		border: 1.5px solid color-mix(in srgb, currentColor 28%, transparent);
		background: color-mix(in oklab, var(--card-bg) 90%, transparent);
	}

	.signal-desk-link:hover {
		transform: translateY(-1px);
		border-color: var(--primary);
		color: var(--primary);
	}

	.signal-github {
		border: 1.5px solid color-mix(in srgb, #dc2626 70%, transparent);
		color: #dc2626;
		background: color-mix(in srgb, #dc2626 6%, transparent);
	}

	.signal-github:hover {
		background: #dc2626;
		color: #fff;
		transform: translateY(-1px);
	}

	.signal-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
	}

	@media (min-width: 720px) {
		.signal-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			gap: 1.15rem;
		}
	}

	@media (min-width: 1100px) {
		.signal-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: 1.25rem;
		}
	}

	.signal-card {
		position: relative;
		min-height: 19rem;
		border-radius: 1.35rem;
		background:
			linear-gradient(
				160deg,
				color-mix(in srgb, #fff 18%, transparent),
				transparent 42%
			),
			var(--signal-bg);
		color: #fff;
		overflow: hidden;
		cursor: pointer;
		box-shadow:
			0 10px 28px color-mix(in srgb, var(--signal-bg) 28%, transparent),
			0 1px 0 color-mix(in srgb, #fff 22%, transparent) inset;
		transition: transform 0.22s ease, box-shadow 0.22s ease;
	}

	.signal-card-link,
	.signal-card-hit {
		position: absolute;
		inset: 0;
		z-index: 3;
		border-radius: inherit;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.signal-card:hover {
		transform: translateY(-4px);
		box-shadow:
			0 16px 36px color-mix(in srgb, var(--signal-bg) 36%, transparent),
			0 1px 0 color-mix(in srgb, #fff 28%, transparent) inset;
	}

	.signal-card.is-soon {
		cursor: default;
		opacity: 0.92;
	}

	.signal-card.is-soon:hover {
		transform: none;
	}

	.signal-card.is-dark-text {
		color: #1c1917;
		box-shadow:
			0 10px 28px color-mix(in srgb, #000 8%, transparent),
			0 1px 0 color-mix(in srgb, #fff 55%, transparent) inset;
	}

	.signal-soon-tag {
		margin-left: 0.35rem;
		font-style: normal;
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.04em;
		opacity: 0.9;
	}

	.signal-numeral {
		position: absolute;
		right: -0.05em;
		bottom: -0.32em;
		z-index: 0;
		font-size: clamp(6.5rem, 16vw, 9.5rem);
		font-weight: 900;
		line-height: 1;
		opacity: 0.14;
		pointer-events: none;
		user-select: none;
		transform: rotate(-6deg);
	}

	.signal-card-inner {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 1.25rem 1.2rem 1.1rem;
		pointer-events: none;
	}

	.signal-kicker {
		margin: 0;
		display: inline-flex;
		align-self: flex-start;
		padding: 0.2rem 0.55rem;
		border-radius: 9999px;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		background: color-mix(in srgb, currentColor 12%, transparent);
	}

	.signal-headline {
		margin: 0.75rem 0 1rem;
		font-size: 1.28rem;
		font-weight: 800;
		letter-spacing: 0.01em;
		line-height: 1.3;
	}

	.signal-sources {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		flex: 1;
	}

	.signal-source-btn {
		position: relative;
		z-index: 4;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.15rem;
		width: 100%;
		padding: 0.55rem 0.7rem;
		border-radius: 0.85rem;
		text-align: left;
		background: color-mix(in srgb, currentColor 8%, transparent);
		transition: background-color 0.15s ease, transform 0.15s ease;
		cursor: pointer;
		pointer-events: auto;
	}

	.signal-source-btn:hover,
	.signal-source-btn:focus-visible {
		background: color-mix(in srgb, currentColor 14%, transparent);
		transform: translateX(2px);
		outline: none;
	}

	.signal-source-btn.is-static {
		cursor: default;
		pointer-events: none;
	}

	.signal-source-btn.is-static:hover,
	.signal-source-btn.is-static:focus-visible {
		background: color-mix(in srgb, currentColor 8%, transparent);
		transform: none;
	}

	.signal-source-btn.copied {
		background: color-mix(in srgb, #16a34a 40%, transparent);
	}

	.signal-source-title {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.9rem;
		font-weight: 700;
		line-height: 1.35;
	}

	.signal-badge {
		font-style: normal;
		font-size: 0.62rem;
		font-weight: 700;
		padding: 0.08rem 0.35rem;
		border-radius: 9999px;
		background: color-mix(in srgb, currentColor 14%, transparent);
	}

	.signal-source-desc {
		font-size: 0.72rem;
		opacity: 0.72;
		line-height: 1.4;
	}

	.signal-card-foot {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 1.1rem;
		padding-top: 0.75rem;
		border-top: 1px solid color-mix(in srgb, currentColor 18%, transparent);
		font-size: 0.72rem;
		font-weight: 650;
		letter-spacing: 0.04em;
		opacity: 0.78;
	}

	.signal-footer {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
		margin-top: 1.25rem;
	}

	@media (min-width: 720px) {
		.signal-footer {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 1rem;
		}
	}

	.signal-stat {
		padding: 1rem 1.1rem;
		border-radius: 1.1rem;
		background: color-mix(in oklab, var(--card-bg) 92%, transparent);
		border: 1px solid color-mix(in oklab, var(--line-divider) 70%, transparent);
		box-shadow: 0 6px 18px color-mix(in srgb, #000 4%, transparent);
	}

	:global(.dark) .signal-stat {
		box-shadow: 0 6px 18px color-mix(in srgb, #000 22%, transparent);
	}

	.signal-stat-label {
		display: block;
		font-size: 0.7rem;
		letter-spacing: 0.06em;
		opacity: 0.5;
		margin-bottom: 0.35rem;
	}

	.signal-stat-value {
		font-size: 1.15rem;
		font-weight: 800;
	}

	.signal-stat-fast .signal-stat-value {
		color: #dc2626;
		font-size: 0.95rem;
		line-height: 1.35;
		word-break: break-word;
	}

	@media (prefers-reduced-motion: reduce) {
		.signal-dot { animation: none; }
		.signal-card,
		.signal-card:hover,
		.signal-github,
		.signal-desk-link,
		.signal-source-btn {
			transition: none;
			transform: none;
		}
	}
</style>

<script>
	function bindSignalDesk(root: ParentNode = document) {
		const desk = root.querySelector("#signal-desk");
		if (!desk) return;

		desk.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
			if (btn.dataset.bound === "1") return;
			btn.dataset.bound = "1";
			btn.addEventListener("click", async (e) => {
				e.preventDefault();
				e.stopPropagation();
				const text = btn.dataset.copy || "";
				if (!text) return;
				try {
					await navigator.clipboard.writeText(text);
				} catch {
					const input = document.createElement("textarea");
					input.value = text;
					document.body.appendChild(input);
					input.select();
					document.execCommand("copy");
					input.remove();
				}
				btn.classList.add("copied");
				window.setTimeout(() => btn.classList.remove("copied"), 1000);
			});
		});

		const hash = decodeURIComponent(window.location.hash.replace(/^#/, ""));
		if (!hash) return;
		const target = document.getElementById(hash);
		if (!target) return;
		requestAnimationFrame(() => {
			target.scrollIntoView({ behavior: "smooth", block: "center" });
		});
	}

	bindSignalDesk();
	document.addEventListener("swup:content:replace", () => bindSignalDesk());
	window.addEventListener("hashchange", () => bindSignalDesk());
</script>
