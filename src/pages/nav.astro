---
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config";
import {
	countPendingSites,
	countPublishedSites,
	navPageConfig,
} from "@/config/navPageConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

if (!siteConfig.pages.nav) {
	return Astro.redirect("/404/");
}

const { title, description, groups, extraPendingCount = 0 } = navPageConfig;

const publishedGroups = groups.map((group) => ({
	...group,
	sites: group.sites.filter((site) => !site.pending),
}));

const siteCount = countPublishedSites(groups);
const pendingCount = countPendingSites(groups, extraPendingCount);
---
<MainGridLayout title={title} description={description}>
	<div class="mb-4 grid grid-cols-2 gap-3 sm:max-w-md">
		<div class="card-base px-4 py-3">
			<p class="text-xs text-neutral-500 dark:text-neutral-400">当前站点</p>
			<p class="mt-1 text-2xl font-bold text-neutral-900 dark:text-neutral-100">
				{siteCount}
				<span class="ml-1 text-sm font-medium text-neutral-400">个</span>
			</p>
		</div>
		<div class="card-base px-4 py-3">
			<p class="text-xs text-neutral-500 dark:text-neutral-400">待审核</p>
			<p class="mt-1 text-2xl font-bold text-neutral-900 dark:text-neutral-100">
				{pendingCount}
				<span class="ml-1 text-sm font-medium text-neutral-400">个</span>
			</p>
		</div>
	</div>

	<div class="nav-directory space-y-5" id="nav-directory">
		{
			publishedGroups.map((group) => (
				<section
					id={group.id}
					class="nav-section card-base scroll-mt-24 p-4 sm:p-5"
					data-group={group.id}
				>
					<header class="mb-3 flex items-center gap-2.5">
						<span class="flex size-8 shrink-0 items-center justify-center rounded-xl bg-(--btn-regular-bg) text-(--primary)">
							<Icon is:inline name={group.icon} class="text-lg" />
						</span>
						<h2 class="text-base font-bold text-neutral-900 dark:text-neutral-100 sm:text-lg">
							{group.name}
						</h2>
						<span class="text-xs text-neutral-400 dark:text-neutral-500">{group.sites.length}</span>
					</header>

					<div class="nav-tags mb-4 flex flex-wrap gap-2" data-tags>
						{group.tags.map((tag, i) => (
							<button
								type="button"
								class:list={["nav-tag", { active: i === 0 }]}
								data-tag={tag}
							>
								{tag}
							</button>
						))}
					</div>

					<div class="nav-grid" data-grid>
						{group.sites.map((site) => (
							<a
								class="nav-card"
								href={site.url}
								target="_blank"
								rel="noopener noreferrer"
								title={site.desc}
								data-site-tags={site.tags.join(",")}
							>
								{site.badge && <span class="nav-badge">{site.badge}</span>}
								<div class="nav-card-icon">
									{site.icon ? (
										<>
											<img
												src={site.icon}
												alt=""
												loading="lazy"
												referrerpolicy="no-referrer"
												data-nav-icon
											/>
											<span class="nav-card-fallback" hidden>
												{site.title.trim().charAt(0)}
											</span>
										</>
									) : (
										<span class="nav-card-fallback" style="display:flex">
											{site.title.trim().charAt(0)}
										</span>
									)}
								</div>
								<div class="nav-card-body min-w-0">
									<div class="nav-card-title truncate">{site.title}</div>
									<div class="nav-card-desc line-clamp-1">{site.desc}</div>
								</div>
								<span class="nav-status" aria-hidden="true" />
							</a>
						))}
					</div>
					<p class="nav-empty hidden py-8 text-center text-sm text-neutral-400 dark:text-neutral-500">
						该分类下暂无站点
					</p>
				</section>
			))
		}
	</div>
</MainGridLayout>

<style>
	.nav-tag {
		border-radius: 9999px;
		padding: 0.35rem 0.85rem;
		font-size: 0.8125rem;
		line-height: 1.25;
		color: rgb(82 82 82);
		background: color-mix(in oklab, var(--btn-plain-bg-hover) 70%, transparent);
		transition: background-color 0.15s ease, color 0.15s ease;
		cursor: pointer;
	}
	:global(.dark) .nav-tag {
		color: rgb(212 212 212);
	}
	.nav-tag:hover {
		color: var(--primary);
	}
	.nav-tag.active {
		background: var(--primary);
		color: white;
	}
	.nav-grid {
		display: grid;
		grid-template-columns: repeat(1, minmax(0, 1fr));
		gap: 0.75rem;
	}
	@media (min-width: 640px) {
		.nav-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	}
	@media (min-width: 900px) {
		.nav-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	}
	@media (min-width: 1280px) {
		.nav-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
	}
	.nav-card {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.85rem 0.9rem;
		border-radius: 0.9rem;
		border: 1px solid color-mix(in oklab, var(--line-divider) 80%, transparent);
		background: color-mix(in oklab, var(--card-bg) 92%, white);
		overflow: hidden;
		transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
	}
	:global(.dark) .nav-card {
		background: color-mix(in oklab, var(--card-bg) 96%, black);
	}
	.nav-card:hover {
		border-color: color-mix(in oklab, var(--primary) 45%, transparent);
		box-shadow: 0 8px 24px color-mix(in oklab, var(--primary) 12%, transparent);
		transform: translateY(-2px);
	}
	.nav-card-icon {
		position: relative;
		width: 2.5rem;
		height: 2.5rem;
		flex-shrink: 0;
		border-radius: 0.7rem;
		overflow: hidden;
		background: color-mix(in oklab, var(--btn-regular-bg) 80%, white);
		display: flex;
		align-items: center;
		justify-content: center;
	}
	.nav-card-icon img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}
	.nav-card-fallback {
		width: 100%;
		height: 100%;
		display: none;
		align-items: center;
		justify-content: center;
		font-size: 0.95rem;
		font-weight: 700;
		color: var(--primary);
		background: color-mix(in oklab, var(--primary) 12%, transparent);
	}
	.nav-card-title {
		font-size: 0.925rem;
		font-weight: 650;
		color: rgb(23 23 23);
	}
	:global(.dark) .nav-card-title {
		color: rgb(245 245 245);
	}
	.nav-card-desc {
		margin-top: 0.15rem;
		font-size: 0.75rem;
		color: rgb(115 115 115);
	}
	:global(.dark) .nav-card-desc {
		color: rgb(163 163 163);
	}
	.nav-badge {
		position: absolute;
		top: 0;
		right: 0;
		padding: 0.1rem 0.45rem;
		font-size: 0.65rem;
		font-weight: 600;
		color: white;
		background: color-mix(in oklab, var(--primary) 85%, #ef4444);
		border-bottom-left-radius: 0.55rem;
	}
	.nav-status {
		position: absolute;
		right: 0.7rem;
		bottom: 0.55rem;
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 9999px;
		background: #22c55e;
		opacity: 0.85;
	}
	.nav-empty.hidden {
		display: none;
	}
	@media (prefers-reduced-motion: reduce) {
		.nav-card, .nav-tag { transition: none; }
		.nav-card:hover { transform: none; }
	}
</style>

<script>
	function bindNavDirectory(root: ParentNode = document) {
		const directory = root.querySelector("#nav-directory");
		if (!directory) return;

		directory.querySelectorAll<HTMLImageElement>("img[data-nav-icon]").forEach((img) => {
			img.addEventListener("error", () => {
				img.style.display = "none";
				const fallback = img.nextElementSibling as HTMLElement | null;
				if (fallback) {
					fallback.hidden = false;
					fallback.style.display = "flex";
				}
			});
		});

		directory.querySelectorAll<HTMLElement>(".nav-section").forEach((section) => {
			const tags = section.querySelector("[data-tags]");
			const grid = section.querySelector("[data-grid]");
			const empty = section.querySelector(".nav-empty");
			if (!tags || !grid || !empty) return;

			tags.querySelectorAll<HTMLButtonElement>(".nav-tag").forEach((btn) => {
				btn.addEventListener("click", () => {
					tags.querySelectorAll(".nav-tag").forEach((el) => el.classList.remove("active"));
					btn.classList.add("active");
					const tag = btn.dataset.tag || "全部";
					let visible = 0;
					grid.querySelectorAll<HTMLElement>(".nav-card").forEach((card) => {
						const siteTags = (card.dataset.siteTags || "").split(",").filter(Boolean);
						const show = tag === "全部" || siteTags.includes(tag);
						card.style.display = show ? "" : "none";
						if (show) visible += 1;
					});
					empty.classList.toggle("hidden", visible > 0);
				});
			});
		});
	}

	function scrollToNavHash() {
		const id = decodeURIComponent(window.location.hash.replace(/^#/, ""));
		if (!id) return;
		const target = document.getElementById(id);
		if (!target) return;
		requestAnimationFrame(() => {
			target.scrollIntoView({ behavior: "smooth", block: "start" });
		});
	}

	bindNavDirectory();
	scrollToNavHash();
	document.addEventListener("swup:content:replace", () => {
		bindNavDirectory();
		scrollToNavHash();
	});
	window.addEventListener("hashchange", scrollToNavHash);
</script>
