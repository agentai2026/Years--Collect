---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Pagination from "@/components/common/Pagination.astro";
import { profileConfig, siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { formatDateToYYYYMMDD } from "@/utils/date-utils";
import { getCategoryUrl, getPostUrlBySlug, url } from "@/utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	const pageSize = siteConfig.pagination.postsPerPage;
	return paginate(allBlogPosts, { pageSize });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const len = page.data.length;

const today = new Date();
const weekdays = ["日", "一", "二", "三", "四", "五", "六"];
const dateLabel = `${today.getFullYear()} 年 ${today.getMonth() + 1} 月 ${today.getDate()} 日 · 周${weekdays[today.getDay()]}`;

const entries = await Promise.all(
	page.data.map(async (entry) => {
		const { remarkPluginFrontmatter } = await render(entry);
		return {
			id: entry.id,
			title: entry.data.title,
			published: entry.data.published,
			category: entry.data.category,
			tags: entry.data.tags || [],
			author: entry.data.author || profileConfig.name,
			sourceLink: entry.data.sourceLink || "",
			href: getPostUrlBySlug(entry.id),
			excerpt:
				entry.data.description ||
				remarkPluginFrontmatter.excerpt ||
				"",
			words: remarkPluginFrontmatter.words as number | undefined,
		};
	}),
);

const totalLabel = `共 ${page.total} 篇 · 第 ${page.currentPage}/${page.lastPage} 页`;
---

<MainGridLayout title="全部文章" description="岁月的文章手记 · 采集与随笔">
	<article class="all-note card-base onload-animation" aria-label="全部文章手记">
		<div class="all-note-glow" aria-hidden="true"></div>

		<header class="all-note-head">
			<p class="all-note-date">{dateLabel}</p>
			<h1 class="all-note-title">读过的，采来的</h1>
			<p class="all-note-from">— {profileConfig.name} · {totalLabel}</p>
			<p class="all-note-lead">
				这里是文章手记：自己写的、从外面采回来的，都放在一起。点开就能看正文；来源站会在文里注明。
			</p>
		</header>

		<nav class="all-note-filters" aria-label="快捷入口">
			<a class="is-active" href={url("/all/")}>全部</a>
			<a href={url("/archive/")}>归档</a>
			<a href={url("/categories/")}>分类</a>
			<a href={url("/tags/")}>标签</a>
		</nav>

		{
			entries.length === 0 ? (
				<p class="all-note-empty">暂时还没有文章。等采集跑起来，或自己写一篇就好。</p>
			) : (
				<ol class="all-note-list">
					{entries.map((item, i) => (
						<li style={`animation-delay: ${0.05 + i * 0.04}s`}>
							<a class="all-note-item" href={item.href}>
								<div class="all-note-item-meta">
									<time datetime={formatDateToYYYYMMDD(item.published)}>
										{formatDateToYYYYMMDD(item.published)}
									</time>
									{item.category && (
										<span class="all-note-cat">{item.category}</span>
									)}
									{item.sourceLink && <span class="all-note-src">采集</span>}
									{item.words ? <span>{item.words} 字</span> : null}
								</div>
								<h2 class="all-note-item-title">{item.title}</h2>
								{item.excerpt && (
									<p class="all-note-item-excerpt">{item.excerpt}</p>
								)}
								{item.tags.length > 0 && (
									<div class="all-note-tags">
										{item.tags.slice(0, 4).map((tag) => (
											<span>#{tag}</span>
										))}
									</div>
								)}
							</a>
						</li>
					))}
				</ol>
			)
		}

		{
			page.total > page.size && (
				<div class="all-note-pager">
					<Pagination
						class="mx-auto"
						page={page}
						style={`animation-delay: calc(var(--content-delay) + ${len * 40}ms)`}
					/>
				</div>
			)
		}

		<footer class="all-note-foot">
			<span>想按年份翻 →</span>
			<a href={url("/archive/")}>去归档</a>
			<span aria-hidden="true">·</span>
			<a href={getCategoryUrl("资讯精选")}>资讯精选</a>
		</footer>
	</article>
</MainGridLayout>

<style>
	.all-note {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		padding: clamp(1.5rem, 3.2vw, 2.25rem) clamp(1.25rem, 3.2vw, 2.35rem)
			clamp(1.25rem, 2.8vw, 1.75rem);
	}

	.all-note-glow {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(
				ellipse 80% 45% at 0% 0%,
				color-mix(in srgb, var(--primary) 14%, transparent),
				transparent 60%
			),
			radial-gradient(
				ellipse 50% 40% at 100% 100%,
				color-mix(in srgb, var(--primary) 8%, transparent),
				transparent 55%
			);
	}

	.all-note-head,
	.all-note-filters,
	.all-note-list,
	.all-note-empty,
	.all-note-pager,
	.all-note-foot {
		position: relative;
		z-index: 1;
	}

	.all-note-head {
		margin-bottom: 1.1rem;
		padding-bottom: 1.1rem;
		border-bottom: 1px dashed color-mix(in oklab, var(--line-divider) 85%, transparent);
		animation: all-note-in 0.55s ease both;
	}

	.all-note-date {
		margin: 0 0 0.55rem;
		font-size: 0.78rem;
		font-weight: 650;
		letter-spacing: 0.04em;
		opacity: 0.45;
	}

	.all-note-title {
		margin: 0;
		font-size: clamp(1.55rem, 3.5vw, 2rem);
		font-weight: 850;
		line-height: 1.35;
		letter-spacing: 0.02em;
	}

	.all-note-from {
		margin: 0.65rem 0 0;
		font-size: 0.88rem;
		opacity: 0.5;
	}

	.all-note-lead {
		margin: 0.9rem 0 0;
		font-size: 0.95rem;
		line-height: 1.85;
		opacity: 0.78;
	}

	.all-note-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-bottom: 1.15rem;
		animation: all-note-in 0.55s ease 0.05s both;
	}

	.all-note-filters a {
		padding: 0.32rem 0.78rem;
		border-radius: 9999px;
		font-size: 0.84rem;
		font-weight: 700;
		opacity: 0.65;
		border: 1px solid transparent;
		transition:
			opacity 0.15s ease,
			background-color 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.all-note-filters a:hover,
	.all-note-filters a.is-active {
		opacity: 1;
		color: var(--primary);
		background: color-mix(in srgb, var(--primary) 10%, transparent);
		border-color: color-mix(in srgb, var(--primary) 18%, transparent);
	}

	.all-note-empty {
		margin: 1.5rem 0;
		font-size: 0.95rem;
		opacity: 0.55;
		line-height: 1.7;
	}

	.all-note-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.all-note-list > li {
		animation: all-note-in 0.5s ease both;
	}

	.all-note-item {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 1rem 1.05rem;
		border-radius: 1rem;
		border: 1px solid color-mix(in srgb, var(--primary) 12%, transparent);
		background: color-mix(in srgb, var(--primary) 4%, transparent);
		transition:
			transform 0.15s ease,
			background-color 0.15s ease,
			border-color 0.15s ease;
	}

	.all-note-item:hover {
		transform: translateX(3px);
		background: color-mix(in srgb, var(--primary) 9%, transparent);
		border-color: color-mix(in srgb, var(--primary) 24%, transparent);
	}

	.all-note-item-meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem 0.65rem;
		font-size: 0.75rem;
		font-weight: 650;
		opacity: 0.48;
	}

	.all-note-cat,
	.all-note-src {
		padding: 0.08rem 0.45rem;
		border-radius: 9999px;
		background: color-mix(in srgb, var(--primary) 12%, transparent);
		color: var(--primary);
		opacity: 1;
	}

	.all-note-src {
		background: color-mix(in srgb, var(--primary) 8%, transparent);
	}

	.all-note-item-title {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 800;
		line-height: 1.45;
		letter-spacing: 0.01em;
	}

	.all-note-item-excerpt {
		margin: 0;
		font-size: 0.88rem;
		line-height: 1.7;
		opacity: 0.58;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.all-note-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.55rem;
		margin-top: 0.15rem;
		font-size: 0.75rem;
		opacity: 0.42;
	}

	.all-note-pager {
		margin-top: 1.5rem;
		padding-top: 0.5rem;
	}

	.all-note-foot {
		margin: 1.35rem 0 0;
		padding-top: 1.1rem;
		border-top: 1px solid color-mix(in oklab, var(--line-divider) 80%, transparent);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.78rem;
		opacity: 0.5;
		animation: all-note-in 0.55s ease 0.2s both;
	}

	.all-note-foot a {
		font-weight: 700;
		color: var(--primary);
		opacity: 0.9;
	}

	.all-note-foot a:hover {
		text-decoration: underline;
	}

	@keyframes all-note-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.all-note-head,
		.all-note-filters,
		.all-note-list > li,
		.all-note-foot {
			animation: none !important;
		}

		.all-note-item:hover {
			transform: none;
		}
	}
</style>
