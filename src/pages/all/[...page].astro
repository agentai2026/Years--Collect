---
import type { GetStaticPaths } from "astro";
import Pagination from "@/components/common/Pagination.astro";
import PostPage from "@/components/layout/PostPage.astro";
import { profileConfig, siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";
import { getCategoryUrl, getTagUrl, url } from "@/utils/url-utils";

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	const pageSize = siteConfig.pagination.postsPerPage;
	return paginate(allBlogPosts, { pageSize });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const len = page.data.length;
const allPosts = await getSortedPosts();

const today = new Date();
const weekdays = ["日", "一", "二", "三", "四", "五", "六"];
const dateLabel = `${today.getFullYear()} 年 ${today.getMonth() + 1} 月 ${today.getDate()} 日 · 周${weekdays[today.getDay()]}`;

const sourceBuckets = new Map<string, number>();
const categoryBuckets = new Map<string, number>();
for (const post of allPosts) {
	const tags = post.data.tags || [];
	const sourceTag =
		tags.find((t) => ["WinDiscover", "吾爱破解", "CoderNav", "采集"].includes(t) && t !== "采集") ||
		(post.data.sourceLink ? "外站采集" : "本站随笔");
	sourceBuckets.set(sourceTag, (sourceBuckets.get(sourceTag) || 0) + 1);
	const cat = post.data.category || "未分类";
	categoryBuckets.set(cat, (categoryBuckets.get(cat) || 0) + 1);
}

const sourceStats = [...sourceBuckets.entries()].sort((a, b) => b[1] - a[1]);
const categoryStats = [...categoryBuckets.entries()].sort((a, b) => b[1] - a[1]);
const collectedCount = allPosts.filter((p) => !!p.data.sourceLink).length;
const ownCount = allPosts.length - collectedCount;
const totalLabel = `共 ${page.total} 篇 · 第 ${page.currentPage}/${page.lastPage} 页`;

const hotTags = [
	...new Set(allPosts.flatMap((p) => p.data.tags || []).filter((t) => t !== "采集")),
].slice(0, 8);
---

<MainGridLayout title="全部文章" description="岁月的文章手记 · 采集与随笔">
	<article class="all-note card-base onload-animation" aria-label="全部文章手记">
		<div class="all-note-glow" aria-hidden="true"></div>

		<header class="all-note-head">
			<p class="all-note-date">{dateLabel}</p>
			<h1 class="all-note-title">读过的，采来的</h1>
			<p class="all-note-from">— {profileConfig.name} · {totalLabel}</p>
			<p class="all-note-lead">
				自己写的、从外面采回来的都放这里。点开看全文；文首会标明出处。下面按完整卡片列出，方便慢慢翻。
			</p>
		</header>

		<section class="all-note-stats" aria-label="文章概览">
			<div class="all-note-stat">
				<strong>{allPosts.length}</strong>
				<span>全部</span>
			</div>
			<div class="all-note-stat">
				<strong>{collectedCount}</strong>
				<span>采集转载</span>
			</div>
			<div class="all-note-stat">
				<strong>{ownCount}</strong>
				<span>本站随笔</span>
			</div>
			<div class="all-note-stat">
				<strong>{categoryStats.length}</strong>
				<span>分类</span>
			</div>
		</section>

		{
			sourceStats.length > 0 && (
				<section class="all-note-sources" aria-label="来源分布">
					<h2>来源</h2>
					<ul>
						{sourceStats.map(([name, count]) => (
							<li>
								<span>{name}</span>
								<em>{count}</em>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<nav class="all-note-filters" aria-label="快捷入口">
			<a class="is-active" href={url("/all/")}>全部</a>
			<a href={url("/archive/")}>归档</a>
			<a href={url("/categories/")}>分类</a>
			<a href={url("/tags/")}>标签</a>
			{categoryStats.slice(0, 3).map(([name]) => (
				<a href={getCategoryUrl(name)}>{name}</a>
			))}
		</nav>

		{
			hotTags.length > 0 && (
				<nav class="all-note-tags-bar" aria-label="热门标签">
					{hotTags.map((tag) => (
						<a href={getTagUrl(tag)}>#{tag}</a>
					))}
				</nav>
			)
		}
	</article>

	<div class="all-note-feed">
		<PostPage page={page} />
		{
			page.total > page.size && (
				<div class="all-note-pager flex w-full justify-center">
					<Pagination
						class="mx-auto"
						page={page}
						style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`}
					/>
				</div>
			)
		}
	</div>
</MainGridLayout>

<style>
	.all-note {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		margin-bottom: 1rem;
		padding: clamp(1.5rem, 3.2vw, 2.25rem) clamp(1.25rem, 3.2vw, 2.35rem)
			clamp(1.15rem, 2.6vw, 1.6rem);
	}

	.all-note-glow {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		background:
			radial-gradient(
				ellipse 80% 45% at 0% 0%,
				color-mix(in srgb, var(--primary) 14%, transparent),
				transparent 60%
			),
			radial-gradient(
				ellipse 50% 40% at 100% 100%,
				color-mix(in srgb, var(--primary) 8%, transparent),
				transparent 55%
			);
	}

	.all-note-head,
	.all-note-stats,
	.all-note-sources,
	.all-note-filters,
	.all-note-tags-bar {
		position: relative;
		z-index: 1;
	}

	.all-note-head {
		margin-bottom: 1.1rem;
		padding-bottom: 1rem;
		border-bottom: 1px dashed color-mix(in oklab, var(--line-divider) 85%, transparent);
		animation: all-note-in 0.55s ease both;
	}

	.all-note-date {
		margin: 0 0 0.55rem;
		font-size: 0.78rem;
		font-weight: 650;
		letter-spacing: 0.04em;
		opacity: 0.45;
	}

	.all-note-title {
		margin: 0;
		font-size: clamp(1.55rem, 3.5vw, 2rem);
		font-weight: 850;
		line-height: 1.35;
		letter-spacing: 0.02em;
	}

	.all-note-from {
		margin: 0.65rem 0 0;
		font-size: 0.88rem;
		opacity: 0.5;
	}

	.all-note-lead {
		margin: 0.9rem 0 0;
		font-size: 0.95rem;
		line-height: 1.85;
		opacity: 0.78;
	}

	.all-note-stats {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.55rem;
		margin-bottom: 1rem;
		animation: all-note-in 0.55s ease 0.04s both;
	}

	.all-note-stat {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 0.75rem 0.7rem;
		border-radius: 0.9rem;
		border: 1px solid color-mix(in srgb, var(--primary) 12%, transparent);
		background: color-mix(in srgb, var(--primary) 5%, transparent);
		text-align: center;
	}

	.all-note-stat strong {
		font-size: 1.25rem;
		font-weight: 850;
		line-height: 1.1;
		color: var(--primary);
	}

	.all-note-stat span {
		font-size: 0.72rem;
		font-weight: 650;
		opacity: 0.5;
	}

	.all-note-sources {
		margin-bottom: 1rem;
		animation: all-note-in 0.55s ease 0.08s both;
	}

	.all-note-sources h2 {
		margin: 0 0 0.55rem;
		font-size: 0.75rem;
		font-weight: 750;
		letter-spacing: 0.08em;
		opacity: 0.42;
	}

	.all-note-sources ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
	}

	.all-note-sources li {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.38rem 0.7rem;
		border-radius: 9999px;
		font-size: 0.82rem;
		font-weight: 700;
		border: 1px solid color-mix(in srgb, var(--primary) 14%, transparent);
		background: color-mix(in srgb, var(--card-bg) 88%, var(--primary));
	}

	.all-note-sources em {
		font-style: normal;
		font-size: 0.75rem;
		opacity: 0.55;
	}

	.all-note-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-bottom: 0.65rem;
		animation: all-note-in 0.55s ease 0.1s both;
	}

	.all-note-filters a {
		padding: 0.32rem 0.78rem;
		border-radius: 9999px;
		font-size: 0.84rem;
		font-weight: 700;
		opacity: 0.65;
		border: 1px solid transparent;
		transition:
			opacity 0.15s ease,
			background-color 0.15s ease,
			border-color 0.15s ease,
			color 0.15s ease;
	}

	.all-note-filters a:hover,
	.all-note-filters a.is-active {
		opacity: 1;
		color: var(--primary);
		background: color-mix(in srgb, var(--primary) 10%, transparent);
		border-color: color-mix(in srgb, var(--primary) 18%, transparent);
	}

	.all-note-tags-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.55rem;
		animation: all-note-in 0.55s ease 0.12s both;
	}

	.all-note-tags-bar a {
		font-size: 0.78rem;
		font-weight: 650;
		opacity: 0.48;
		transition: opacity 0.15s ease, color 0.15s ease;
	}

	.all-note-tags-bar a:hover {
		opacity: 1;
		color: var(--primary);
	}

	.all-note-feed {
		margin-bottom: 0.5rem;
	}

	.all-note-pager {
		margin-top: 0.25rem;
		margin-bottom: 1rem;
	}

	@keyframes all-note-in {
		from {
			opacity: 0;
			transform: translateY(8px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (max-width: 640px) {
		.all-note-stats {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.all-note-head,
		.all-note-stats,
		.all-note-sources,
		.all-note-filters,
		.all-note-tags-bar {
			animation: none !important;
		}
	}
</style>
